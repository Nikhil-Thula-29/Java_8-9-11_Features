package com.nt.collectionenhancements;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

public class LimitSkipFlatmap {

	public static void main(String[] args) {
		List<Integer> li=new ArrayList<Integer>();
		li.add(10);
		li.add(15);
		li.add(20);
		li.add(30);
		li.add(45);
		li.add(55);
		li.add(55);
		li.add(45);
		li.add(15);
		
		//limit up to 4
		li.stream().limit(4).forEach((x)->System.out.println(x));
		
		//to print highest number
		System.out.println("Print the highest number");
		li.stream().sorted(Collections.reverseOrder()).limit(1).forEach((x)->System.out.println(x));
		
		//skip
		System.out.println("Skipping the first 3 elements");
		li.stream().skip(3).forEach((x)->System.out.println(x));
		
		//Write a programm to print the second largest number
		li.stream().sorted(Collections.reverseOrder()).limit(2).skip(1).forEach((x)->System.out.println(x));
		
	}
}
