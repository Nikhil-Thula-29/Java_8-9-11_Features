package com.nt.collectionenhancements;

import java.util.ArrayList;
import java.util.List;
import java.util.function.Consumer;

public class CollectionsEnhancements {

	public static void main(String[] args) {
		List<Integer> al=new ArrayList<>();
		al.add(10);
		al.add(20);
		al.add(30);
		al.add(40);
		
		System.out.println("Before java 8");
		for(int i=0;i<al.size();i++) {
			System.out.println(al.get(i));
		}
		
		System.out.println("After java 8");
		Consumer<Integer> con=(x)->{
			System.out.println(x);
		};
		al.forEach(con);
		
		List<Employee> emp=new ArrayList<Employee>();
		emp.add(new Employee(1,"Nikhil",50050.033));
		emp.add(new Employee(2,"Raju",38000.0));
		emp.add(new Employee(3,"Rani",35400.0));
		emp.add(new Employee(4,"Kalyan",20000.0));
		
		 
		System.out.println("Before java 8 Employee");
		for(int i=0;i<emp.size();i++) {
			System.out.println("Employee id is: "+emp.get(i).getEmpId());
			System.out.println("Employee Name is: "+emp.get(i).getEmpName());
			System.out.println("Employee Salaray is: "+emp.get(i).getSal());
		}
		
		
		System.out.println("After java 8 Employee");
		Consumer cons=(x)->{
			System.out.println("Employee id is: "+((Employee) x).getEmpId());
			System.out.println("Employee Name is: "+((Employee) x).getEmpName());
			System.out.println("Employee Salaray is: "+((Employee) x).getSal());
		};
		emp.forEach(cons);
		System.out.println("OR");
		emp.forEach((x)->{
			//emp.remove(x); //concurrentModification exception
			System.out.println("Employee id is: "+x.getEmpId());
			System.out.println("Employee Name is: "+ x.getEmpName());
			System.out.println("Employee Salaray is: "+x.getSal());
		});
		
		emp.removeIf((x)->{
			return x.getEmpName().startsWith("Ra");
		});
		
		System.out.println("After remove If");
		
		
	}
}
