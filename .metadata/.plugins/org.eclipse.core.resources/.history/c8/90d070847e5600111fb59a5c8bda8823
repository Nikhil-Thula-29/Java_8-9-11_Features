package com.nt.java8features;

public class Employee {

	public static void main(String[] args) {
		Test t1= ()->{
			System.out.println("This is display method");
		};
		
		t1.display();
		
		Test2 t2=(a)->{
			System.out.println("This is function "+a);
			return a;
		};
		t2.sum(10);
		
		Test3 t3=(x)->{
			System.out.println("this is predicate "+x);
			return true;
		};
		t3.sum(100);
		
		Test4 t4=()->{
			return "this is supplier --Raju";
		};
		t4.name();
		
		Test5 t5=(a)->{
			System.out.println("this is consumer "+a);
		};
		t5.sub(50);
	}
}
