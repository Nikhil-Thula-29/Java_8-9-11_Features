package com.nt.collectionenhancements;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

public class LimitSkipFlatmap {

	public static void main(String[] args) {
		List<Integer> li=new ArrayList<Integer>();
		li.add(10);
		li.add(15);
		li.add(20);
		li.add(30);
		li.add(45);
		li.add(55);
		li.add(55);
		li.add(45);
		li.add(15);
		
		//limit
		li.stream().limit(4).forEach((x)->System.out.println(x));
		
		li.stream().sorted(Collections.reverseOrder()).limit(2).forEach((x)->System.out.println(x));
		
	}
}
