package com.nt.collectionenhancements;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;

public class MinMaxSort {

	public static void main(String[] args) {
		List<Integer> li=new ArrayList<>();
		li.add(10);
		li.add(93);
		li.add(36);
		li.add(55);
		li.add(21);
		
		Integer min=li.get(0);
		for(int i=1;i<li.size();i++) {
			if(li.get(i)<min) {
				min=li.get(i);
			}
		}
		System.out.println("With for loop "+min);
		
		//write a program to print min number from list
		Comparator<Integer> comp=(x,y)->{
			return (x<y) ? -1:((x==y) ? 1:0);
		};
		System.out.println(li.stream().min(comp).get()); //min and max will return optional so use .get rem
		
		List<Employee> emp=new ArrayList<Employee>();
		emp.add(new Employee(1,"Nikhil",50050.033));
		emp.add(new Employee(2,"Raju",38000.0));
		emp.add(new Employee(3,"Rani",35400.0));
		emp.add(new Employee(4,"Kalyan",20000.0));
		
		//Write a stream program to print emp name who is getting maximum salary
		Comparator<Employee> compa=(x,y)->{
			return (x.getSal()<y.getSal()) ? -1:((x.getSal()==y.getSal()) ? 0:1);
		};
		String name=emp.stream().max(compa).get().getEmpName();
		System.out.println("Max name is : "+name);
		
		
		Comparator<Employee> compara=(x,y)->{
			return (x.getSal()<y.getSal()) ? -1:((x.getSal()==y.getSal()) ? 0:1);
		};
		String minname=emp.stream().min(compara).get().getEmpName();
		System.out.println("Min name is : "+minname);
		
		//Write a program to sort the list of number
		System.out.println(li.stream().sorted());
	}
}
