package com.nt.collectionenhancements;

import java.util.ArrayList;
import java.util.List;
import java.util.stream.Collectors;

public class DistinctGroupByCount {

	public static void main(String[] args) {
		List<Integer> li=new ArrayList<Integer>();
		li.add(10);
		li.add(53);
		li.add(48);
		li.add(16);
		li.add(28);
		li.add(33);
		li.add(33);
		li.add(16);
		li.add(48);
		
		//Removing the duplicates from the list
		System.out.println(li.stream().distinct().collect(Collectors.toList()));
		long duplicateCount=li.stream().count();
	}
}
