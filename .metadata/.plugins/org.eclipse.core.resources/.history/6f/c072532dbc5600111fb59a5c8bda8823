package com.nt.collectionenhancements;

import java.util.ArrayList;
import java.util.List;
import java.util.stream.Stream;

public class StreamExample {

	public static void main(String[] args) {
		Stream<Integer> stream= Stream.of(1,2,3,4);
		stream.forEach((x)->System.out.println(x));
		
		List<Employee> emp=new ArrayList<Employee>();
		emp.add(new Employee(1,"Nikhil",50050.033));
		emp.add(new Employee(2,"Raju",38000.0));
		emp.add(new Employee(3,"Rani",35400.0));
		emp.add(new Employee(4,"Kalyan",20000.0));
		
		for(int i=0;i<emp.size();i++) {
			if(emp.get(i).getEmpName().startsWith("Ra")) {
				System.out.println(emp.get(i).getEmpName());
			}
		}
		
		emp.stream().filter((x)->x.getEmpName().startsWith("Ra")).forEach((y)->System.out.println(y.getEmpName()));
		
		List<String> s1=new ArrayList<String>();
		s1.add("Nikhil");
		s1.add("Kiran");
		s1.add("vamshi");
		s1.add("Rajesh");
	}
}
