package com.nt.java8features;

import java.util.function.Function;

public class EmployeeWithPreDefinedClasses {

	public static void main(String[] args) {
		//Function-->Take arg and return arg
		//Supplier--> takes nothing but return something
		//Predicate-->takes no args and return boolean
		//Consumer-->takes arg but return nothing
		
		Function<String, String> fun=(x)->{
			System.out.println("This is function "+x);
			return "Your full Name is : Nikhil "+x;
		};
		System.out.println(fun.apply("Thula"));
	}
}
